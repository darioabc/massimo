{
  "description": "Tells a new session where the repo's massimo design-system project stands, so work resumes instead of restarting, and keeps massimo's reviewers from writing and its ideator inside the explorations folder.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/agent-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

{
  "$description": "Every DTCG 2025.10 type, for the golden output tests.",
  "color": {
    "$type": "color",
    "ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0,
          0
        ],
        "alpha": 0.2
      },
      "$description": "Hairlines and shadows"
    },
    "teal": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.7,
          0.1,
          200
        ],
        "hex": "#40b1b7"
      }
    },
    "vivid": {
      "$value": {
        "colorSpace": "display-p3",
        "components": [
          1,
          0,
          0
        ],
        "alpha": 0.5
      }
    },
    "white": {
      "$value": {
        "colorSpace": "hsl",
        "components": [
          "none",
          0,
          100
        ]
      }
    },
    "film": {
      "$value": {
        "colorSpace": "rec2020",
        "components": [
          0.5,
          0.25,
          1
        ]
      }
    },
    "bg": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ]
      }
    },
    "text": {
      "$value": "{color.ink}",
      "$extensions": {
        "massimo": {
          "contrast": {
            "on": "color.bg",
            "use": "text"
          }
        }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Inter",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": "JetBrains Mono"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "strong": {
        "$value": "semi-bold"
      }
    }
  },
  "size": {
    "$type": "dimension",
    "lg": {
      "$value": {
        "value": 1.125,
        "unit": "rem"
      }
    },
    "hairline": {
      "$value": {
        "value": 1,
        "unit": "px"
      }
    }
  },
  "space": {
    "1": {
      "$value": {
        "value": 0.25,
        "unit": "rem"
      }
    },
    "2": {
      "$value": {
        "value": 0.5,
        "unit": "rem"
      }
    },
    "$type": "dimension"
  },
  "radius": {
    "$type": "dimension",
    "md": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "full": {
      "$value": {
        "value": 9999,
        "unit": "px"
      }
    }
  },
  "text": {
    "$type": "typography",
    "body": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{size.lg}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": 1.5,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "label": {
      "$value": {
        "fontFamily": [
          "Inter",
          "sans-serif"
        ],
        "fontSize": {
          "value": 0.75,
          "unit": "rem"
        },
        "fontWeight": "semi-bold",
        "lineHeight": 1.2,
        "letterSpacing": {
          "value": 0.02,
          "unit": "rem"
        }
      }
    }
  },
  "border": {
    "$type": "border",
    "thin": {
      "$value": {
        "color": "{color.ink}",
        "width": "{size.hairline}",
        "style": "solid"
      }
    }
  },
  "motion": {
    "fast": {
      "$type": "duration",
      "$value": {
        "value": 150,
        "unit": "ms"
      }
    },
    "ease": {
      "$type": "cubicBezier",
      "$value": [
        0.4,
        0,
        0.2,
        1
      ]
    },
    "emphasis": {
      "$type": "transition",
      "$value": {
        "duration": "{motion.fast}",
        "delay": {
          "value": 0,
          "unit": "ms"
        },
        "timingFunction": "{motion.ease}"
      }
    }
  },
  "gradient": {
    "$type": "gradient",
    "sky": {
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [
              0,
              0,
              1
            ]
          },
          "position": 0
        },
        {
          "color": "{color.teal}",
          "position": 1
        }
      ]
    }
  },
  "shadow": {
    "$type": "shadow",
    "card": {
      "$value": {
        "color": "{color.ink}",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 1,
          "unit": "px"
        },
        "blur": {
          "value": 2,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "ring": {
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [
              0,
              0,
              0
            ],
            "alpha": 0.1
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 4,
            "unit": "px"
          },
          "blur": {
            "value": 12,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        {
          "color": "{color.ink}",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 0,
            "unit": "px"
          },
          "blur": {
            "value": 0,
            "unit": "px"
          },
          "spread": {
            "value": 1,
            "unit": "px"
          },
          "inset": true
        }
      ]
    }
  },
  "stroke": {
    "$type": "strokeStyle",
    "focus": {
      "$value": "dashed"
    }
  },
  "layer": {
    "$type": "number",
    "modal": {
      "$value": 50
    }
  },
  "opacity": {
    "$type": "number",
    "scrim": {
      "$value": 0.6,
      "$deprecated": "Use a color with alpha"
    }
  },
  "$extensions": {
    "massimo": {
      "format": 2
    }
  }
}

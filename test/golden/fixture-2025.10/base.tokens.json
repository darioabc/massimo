{
  "$description": "Design tokens. Written by massimo in the W3C Design Tokens format 2025.10.",
  "color": {
    "$type": "color",
    "neutral": {
      "0": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1,
            1,
            1
          ],
          "hex": "#ffffff"
        }
      },
      "500": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.4667,
            0.4667,
            0.4667
          ],
          "hex": "#777777"
        }
      },
      "950": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0392,
            0.0392,
            0.0392
          ],
          "hex": "#0a0a0a"
        }
      }
    },
    "bg": {
      "default": {
        "$value": "{color.neutral.0}",
        "$description": "Page background"
      }
    },
    "fg": {
      "muted": {
        "$value": "{color.neutral.500}",
        "$description": "Secondary text",
        "$extensions": {
          "massimo": {
            "contrast": {
              "on": "color.bg.default",
              "use": "text"
            }
          }
        }
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "1": {
      "$value": {
        "value": 0.25,
        "unit": "rem"
      }
    },
    "2": {
      "$value": {
        "value": 0.5,
        "unit": "rem"
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "md": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    }
  },
  "font": {
    "$type": "fontFamily",
    "sans": {
      "$value": [
        "Geist Sans",
        "system-ui",
        "sans-serif"
      ]
    }
  },
  "text": {
    "$type": "dimension",
    "lg": {
      "$value": {
        "value": 1.125,
        "unit": "rem"
      }
    }
  },
  "size": {
    "$type": "dimension",
    "touch": {
      "$value": {
        "value": 44,
        "unit": "px"
      },
      "$extensions": {
        "massimo": {
          "cssVar": "--touch-target"
        }
      }
    }
  },
  "$extensions": {
    "massimo": {
      "format": 2
    }
  }
}

{
  "$description": "Draft proposed by massimo from what this repo already uses. Nothing here is in use yet: review it with the tokens skill.",
  "color": {
    "$type": "color",
    "brand-teal": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0.8275,
          0.7333
        ],
        "hex": "#00d3bb"
      },
      "$extensions": {
        "massimo": {
          "cssVar": "--brand-teal"
        }
      }
    },
    "base-100": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          1,
          0,
          0
        ],
        "hex": "#ffffff"
      },
      "$description": "Background"
    },
    "base-content": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.21,
          0.006,
          285.885
        ],
        "hex": "#18181b"
      },
      "$description": "Text and icons on base backgrounds",
      "$extensions": {
        "massimo": {
          "contrast": {
            "on": "color.base-100",
            "use": "text"
          }
        }
      }
    },
    "brand": {
      "$value": "{color.brand-teal}",
      "$description": "Brand colour for primary actions and emphasis"
    },
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0784,
          0.7216,
          0.651
        ],
        "hex": "#14b8a6"
      },
      "$description": "Brand colour for primary actions and emphasis"
    }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "Geist Sans",
        "system-ui",
        "sans-serif"
      ]
    },
    "size": {
      "$type": "dimension",
      "13": {
        "$value": {
          "value": 0.8125,
          "unit": "rem"
        }
      }
    }
  },
  "other": {
    "$type": "dimension",
    "page-max": {
      "$value": {
        "value": 80,
        "unit": "rem"
      },
      "$extensions": {
        "massimo": {
          "cssVar": "--page-max"
        }
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "field": {
      "$value": {
        "value": 0.25,
        "unit": "rem"
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "card": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ],
          "hex": "#000000",
          "alpha": 0.1
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 1,
          "unit": "px"
        },
        "blur": {
          "value": 2,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": {
        "value": 0.25,
        "unit": "rem"
      },
      "$extensions": {
        "massimo": {
          "cssVar": "--spacing"
        }
      }
    },
    "1_5": {
      "$value": {
        "value": 0.375,
        "unit": "rem"
      }
    }
  },
  "typography": {
    "$type": "typography",
    "13": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "{font.size.13}",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  },
  "$extensions": {
    "massimo": {
      "format": 2
    }
  }
}

{
  "$description": "What changes in the dark context.",
  "color": {
    "$type": "color",
    "brand-teal": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          1,
          0.9333
        ],
        "hex": "#00ffee"
      },
      "$extensions": {
        "massimo": {
          "cssVar": "--brand-teal"
        }
      }
    },
    "base-100": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2533,
          0.016,
          252.42
        ],
        "hex": "#1d232a"
      },
      "$description": "Background"
    },
    "base-content": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.97807,
          0.029,
          256.847
        ],
        "hex": "#ecf9ff"
      },
      "$description": "Text and icons on base backgrounds",
      "$extensions": {
        "massimo": {
          "contrast": {
            "on": "color.base-100",
            "use": "text"
          }
        }
      }
    },
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.1765,
          0.8314,
          0.749
        ],
        "hex": "#2dd4bf"
      },
      "$description": "Brand colour for primary actions and emphasis"
    }
  },
  "other": {
    "$type": "dimension",
    "page-max": {
      "$value": {
        "value": 70,
        "unit": "rem"
      },
      "$extensions": {
        "massimo": {
          "cssVar": "--page-max"
        }
      }
    }
  },
  "$extensions": {
    "massimo": {
      "format": 2
    }
  }
}

---
// ds:group Primitives / Actions
// ds:inputs --card-gap
---

<div class="min-[400px]:flex md:p-2 lg:p-4 tablet:hidden bg-black/50 text-[color:var(--c-text)] bg-[var(--c-line)] p-[6px]">
  <span style="gap: var(--card-gap); color: rgb(var(--sand-200)); margin: var(--space-4)">card</span>
</div>

<style>
  @media (min-width: 40.0625rem) {
    div { border-color: var(--c-line); }
  }
  @media (min-width: 30rem) {
    div { display: grid; }
  }
</style>

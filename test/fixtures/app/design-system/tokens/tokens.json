{
  "color": {
    "$type": "color",
    "neutral": {
      "0": { "$value": "#ffffff" },
      "500": { "$value": "#777777" },
      "950": { "$value": "#0a0a0a" }
    },
    "bg": {
      "default": {
        "$value": "{color.neutral.0}",
        "$description": "Page background",
        "$extensions": { "massimo": { "modes": { "dark": "{color.neutral.950}" } } }
      }
    },
    "fg": {
      "muted": {
        "$value": "{color.neutral.500}",
        "$description": "Secondary text",
        "$extensions": { "massimo": { "on": "color.bg.default", "contrast": 4.5, "modes": { "dark": "#9a9a9a" } } }
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" }
  },
  "radius": { "$type": "dimension", "md": { "$value": "6px" } },
  "font": {
    "sans": { "$type": "fontFamily", "$value": ["Geist Sans", "system-ui", "sans-serif"] }
  },
  "text": { "$type": "dimension", "lg": { "$value": "1.125rem" } },
  "size": { "$type": "dimension", "touch": { "$value": "44px", "$extensions": { "massimo": { "cssVar": "--touch-target" } } } }
}
